pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
 stars={}
 st_cl={1,5,6,7,13}
 spd=3
 
 for i=1,#st_cl do
  for j=1,10 do
   local s={
   	x=rnd(128),
   	y=rnd(128),
   	z=i,
   	c=st_cl[i]
   }
   add(stars,s)
  end
 end

 sp=1
 --bl=16
 speed=.2
 --sp2=.4
 player={x=63,y=63,state="idle"}
end

function _update60()
 --stars
 for s in all(stars) do
  s.y+=s.z*spd/10
  if s.y>128 then
  	s.y=0
  	s.x=rnd(128)
  end
 end

 --player
 if btn(0) then player.x-=.5 end
 if btn(1) then player.x+=.5 end
 if btn(2) then player.y-=.5 end
 if btn(3) then player.y+=.5 end
 
 if btn(5) then
  player.state="shoot"
  sp=6
 else
  player.state="idle"
 end
end

function _draw()
 cls()
 for s in all(stars) do
  pset(s.x,s.y,s.c)
 end

 if player.state=="idle" then
  if sp<6-speed then
   sp+=speed
  else
   sp=1
  end
 end
 
 --[[if bl<26-sp2 then
  bl+=sp2
 else
  bl=16
 end]]
 
 spr(sp,player.x,player.y)
 --spr(bl,25,25)
end
