pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
 sp=1
 bl=16
 speed=.6
 sp2=.4
 player={x=63,y=63,state="idle"}
end

function _update()
 if btn(0) then player.x-=1 end
 if btn(1) then player.x+=1 end
 if btn(2) then player.y-=1 end 
 if btn(3) then player.y+=1 end
 
 if btn(5) then
  player.state="shoot"
  sp=6
 else
  player.state="idle"
 end
 
end

function _draw()
 cls()
 
 if player.state=="idle" then
  if sp<6-speed then
   sp+=speed
  else
   sp=1
  end
 end
 
 if bl<26-sp2 then
  bl+=sp2
 else
  bl=16
 end
 
 spr(sp,player.x,player.y)
 spr(bl,25,25)
end


